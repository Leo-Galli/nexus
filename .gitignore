# Rust
# Cargo.lock IS committed on purpose: nexus is a binary application, and
# Flatpak's offline cargo-sources.json is generated from this exact lock
# file, so it must be reproducible from the repo alone.
/target/
**/target/

# Meson
/_build/
/build/

# Generated at build time from src/config.rs.in — never hand-edited.
/src/config.rs

# Flatpak
.flatpak-builder/
/repo/
*.flatpak

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store

# Local Claude Code session state — not project content.
.claude/

# Generated by flatpak-cargo-generator; regenerate from a fresh Cargo.lock
# before a real Flathub submission rather than trusting a stale copy.
/build-aux/flatpak/cargo-sources.json
